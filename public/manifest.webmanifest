  "icons": [
    { "src": "/icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/apple-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Generate article", "short_name": "Generate", "url": "/wiki/generate", "icons": [{ "src": "/icon.png", "sizes": "192x192" }] },
    { "name": "Chat", "short_name": "Chat", "url": "/ask", "icons": [{ "src": "/icon.png", "sizes": "192x192" }] },
    { "name": "3D Galaxy", "short_name": "Galaxy", "url": "/map-3d", "icons": [{ "src": "/icon.png", "sizes": "192x192" }] }
  ]
