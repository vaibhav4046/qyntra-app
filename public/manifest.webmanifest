{
  "name": "Qyntra — Personal Knowledge OS",
  "short_name": "Qyntra",
  "description": "Your own private Wikipedia, compiled from your files, notes and conversations. Cited answers. 3D galaxy view.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#ff5b1f",
  "orientation": "any",
